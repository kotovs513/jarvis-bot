# ─── Скопируй этот файл в .env и вставь свои значения ───

# Токен Telegram-бота (получишь у @BotFather)
TELEGRAM_TOKEN=сюда_вставь_токен

# Ключ OpenAI (нужен для расшифровки голоса и умной сортировки)
OPENAI_API_KEY=sk-...

# Ключ интеграции Notion (начинается на secret_ или ntn_)
NOTION_TOKEN=secret_...

# ID базы Notion, куда падают задачи (32 символа из ссылки на базу)
NOTION_DATABASE_ID=...

# Часовой пояс (чтобы «завтра в 10» считалось правильно)
TIMEZONE=Europe/Moscow

# Модель для сортировки (можно не трогать)
LLM_MODEL=gpt-4o-mini
